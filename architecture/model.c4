model {

  operator = actor 'Operator' {
    summary 'The person triaging the inbox. Supplies the API key themselves.'
    description '''
      Also whoever runs the tool from a clone. It ships configured but never carries
      a credential, so the key comes from whoever runs it.
    '''
    metadata { spec 'docs/DESIGN.md#5' }
  }

  openrouter = external 'OpenRouter' {
    technology 'HTTPS · /chat/completions'
    summary 'The model provider. One call per message, with a strict output shape attached.'
    description '''
      Two traps live at this boundary, both guarded in code. Schema support belongs to the *endpoint*, not
      the model name, so the request must also say `require_parameters` — without it the provider can
      return ordinary prose with a success code. And a model list longer than three is rejected as
      malformed, which kills the call rather than falling through.
    '''
    metadata { spec 'docs/DESIGN.md#6' }
  }

  triage = system 'Inbound Triage Assistant' {
    technology 'React 19 · Vite · Node 24 · node:sqlite'
    summary 'Reads a shared inbox and sorts it: a summary, a category, a priority and a next step per message.'
    description '''
      A local, single-user tool. It shows the sorted queue in a grid you can filter and expand.

      The design turns on two claims, and both are visible in these views: the API key never crosses into
      the browser, and the step that combines the rule layer with the model calls no model itself.
    '''
    link ../docs/DESIGN.md 'design'
    metadata { spec 'docs/DESIGN.md' }

    // ── Browser lane ────────────────────────────────────────────────────────────────────────────
    browser = container 'Browser' {
      #boundary
      technology 'React 19'
      summary 'Everything the operator sees. Holds no credential of any kind.'
      description '''
        Not a key, not a token, not a masked placeholder. It asks the local server for rows and renders
        them.
      '''
      metadata { spec 'docs/DESIGN.md#5' }

      ui = component 'Triage grid' {
        #built
        technology 'React · hand-written CSS'
        summary 'Tag chips, a filter bar with live counts, and rows that expand in place.'
        description '''
          Built in the idiom of a spreadsheet tool. An expanded row shows the full message, the suggested
          action, and — when a call failed — every attempt with its model and failure kind.

          The shape is deliberate: the role asks for spreadsheet-tool fluency and the write-up has to
          explain how this data would be modelled there, so the interface is the visual half of that
          written answer.
        '''
        link ../src/ui/Grid.tsx 'source'
        metadata {
          spec 'docs/DESIGN.md#8'
          file 'src/ui/Grid.tsx'
        }
      }

      summarybar = component 'Run summary bar' {
        #built
        summary 'One line after every run: how many were triaged, how many were not, and the last failure.'
        description '''
          Always present, never blank. A clean run says so. When the model chain is exhausted for an item,
          this is the headline that tells a human to look — a row sitting quietly in a queue is not loud
          enough for that.
        '''
        link ../src/ui/SummaryBar.tsx 'source'
        metadata {
          spec 'docs/DESIGN.md#4.2d'
          file 'src/ui/SummaryBar.tsx'
        }
      }

      apiclient = component 'API client' {
        #built
        summary 'The single place any URL appears. Sends plain requests, receives rows.'
        link ../src/ui/api.ts 'source'
        metadata {
          spec 'docs/DESIGN.md#8'
          file 'src/ui/api.ts'
        }
      }
    }

    // ── Node lane ───────────────────────────────────────────────────────────────────────────────
    node = container 'Node process' {
      #boundary
      technology 'Node 24 · Vite middleware'
      summary 'The only place the API key exists. Also owns the database.'
      description '''
        The key is read from the environment with an empty variable prefix — the specific line that keeps
        it out of the browser bundle — used to build the outbound request, and never returned in any
        response, not even masked.

        Because this process owns the database anyway, the key has a natural home and needs no separate
        service to hold it.
      '''
      metadata { spec 'docs/DESIGN.md#5' }

      preflight = component 'Preflight' {
        #built
        summary 'Refuses to start when the Node version is too old or no API key is set.'
        description '''
          It names the variable and the two commands that fix it. There is deliberately no offline mode: a
          key-less mode was designed and cut, because it would have been a cushion for a stated
          requirement.
        '''
        link ../scripts/preflight.ts 'source'
        metadata {
          spec 'docs/DESIGN.md#5'
          file 'scripts/preflight.ts'
        }
      }

      server = component 'API surface' {
        #built
        technology 'Vite configureServer middleware'
        summary 'List messages, list results, run the triage, retry what is pending, report health.'
        description 'Reads are GET so they can be opened in a browser tab while debugging.'
        link ../src/server/handlers.ts 'source'
        metadata {
          spec 'docs/DESIGN.md#5'
          file 'src/server/handlers.ts'
        }
      }

      engine = container 'Triage engine' {
        technology 'TypeScript'
        summary 'The pipeline. A factory, not a module with global state.'
        description '''
          Configuration is passed in, never imported. That is what lets several instances coexist in one
          process, and it costs nothing — it is the absence of shared state rather than an added
          subsystem.
        '''
        metadata { spec 'docs/DESIGN.md#2.3' }

        ingest = component 'Loader' {
          #built
          summary 'Reads the message file and repairs it before parsing.'
          description '''
            The supplied sample file is *itself* one of the planted edge cases: one message body contains
            escape sequences that are illegal in JSON, so a strict parse of the whole file fails.

            The repair rewrites them to a legal form carrying the same characters, which keeps the
            corrupted bytes intact so a later stage can still recognise that message as garbage rather
            than quietly laundering it clean.
          '''
          link ../src/ingest/load.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#4.1'
            file 'src/ingest/load.ts'
          }
        }

        observations = component 'Observations' {
          #built
          summary 'Turns each message into a fixed list of factual readings — every signal, present or absent.'
          description '''
            Does the sender claim to be a client, is there a deadline, is there complaint language, is this
            bulk mail, is the body effectively empty, does it contain transport garbage.

            The list is *symmetric*: every signal reported either way, in a fixed order, with no emphasis
            on any of them. That is what keeps it an instrument reading rather than a suggestion — and it
            is the reason it can be shown to the model at all.
          '''
          link ../src/triage/observations.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#5b'
            file 'src/triage/observations.ts'
          }
        }

        rules = component 'Rule floor' {
          #built
          summary 'The deterministic verdict, from the observations alone. Not a fallback — it always runs.'
          description '''
            A category and a priority with a confidence that rises with the number of *independent* signals
            that agreed. It is one of the two inputs the next stage combines, on every message.
          '''
          link ../src/triage/rules.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#4.3'
            file 'src/triage/rules.ts'
          }
        }

        prompt = component 'Prompt builder' {
          #built
          summary 'Sends the raw message plus the observations — and deliberately withholds the verdict.'
          description '''
            The instructions are built from the taxonomy rows themselves, so the categories described in
            prose can never drift from the ones the model may choose.

            Handing a model a suggested answer is absorbed silently: the reply still reads as independent
            judgment while no longer being any, and the comparison downstream would then be two opinions
            from one source.
          '''
          link ../src/triage/prompt.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#5b'
            file 'src/triage/prompt.ts'
          }
        }

        llm = component 'Model transport' {
          #built
          technology 'fetch · injectable'
          summary 'One outbound call per message, with each failure kind kept distinct.'
          description '''
            A rejected key, an unfunded account, a rate limit, a timeout, a server error, a network
            failure, an unusable reply — separate kinds, because the fix differs per kind and the
            interface names the fix.

            Notably an unfunded account is *not* folded in with a rate limit: one means fund the key, the
            other means wait. The sibling project in this workspace conflates them; this corrects it.
          '''
          link ../src/llm/client.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#4.2b'
            file 'src/llm/client.ts'
          }
        }

        validate = component 'Re-validation' {
          #built
          summary 'Checks every field again, because a constrained output is a strong hint and not a guarantee.'
          description '''
            A near-miss is a failure, not something to quietly repair — silently correcting a wrong label
            hides a real prompt defect.

            It also separates a reply cut off mid-generation from one that was simply wrong: the first is
            fixed by allowing more room and retrying the same model, the second by trying a different one.
          '''
          link ../src/triage/validate.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#5b'
            file 'src/triage/validate.ts'
          }
        }

        reconcile = component 'Reconciliation' {
          #surprise
          #built
          summary 'Where the two verdicts meet — and it calls no model. Ordinary code.'
          description '''
            There is exactly one model call per message and it already happened by the time this runs.

            Two rules do the work. Priority takes the *higher* of the two, so the rule layer can raise
            urgency but never lower it — a model that under-reads an angry client is the expensive mistake,
            while a false high costs one glance. Category takes the model's answer *unless* the sender
            explicitly said they were a client, because that is a fact stated in the text.
          '''
          link ../src/triage/reconcile.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#4.3'
            file 'src/triage/reconcile.ts'
          }
        }

        retry = component 'Retry queue' {
          #built
          summary 'A record of work that could not be done yet — including work blocked on the operator.'
          description '''
            Not a mechanism for waiting out an outage. It drains whenever the blocker clears, which is why
            a rejected or unfunded key queues rather than being abandoned: the *operator* can fix that.

            An unusable reply is different — it walks to the next model in the chain in our own code,
            because the provider only falls through on its own errors and a reply that arrived
            successfully but wrong is, to it, a success.
          '''
          link ../src/triage/retry.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#4.2c'
            file 'src/triage/retry.ts'
          }
        }

        pool = component 'Bounded pool' {
          #built
          summary 'Runs a few messages at a time, returning results in input order.'
          description '''
            Without it the queue is either serial and slow or unbounded and rate-limited. One failed call
            does not stop the others.
          '''
          link ../src/lib/pool.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#2.3'
            file 'src/lib/pool.ts'
          }
        }
      }

      store = container 'Store' {
        summary 'One interface, one real implementation, one documented migration path.'
        metadata { spec 'docs/DESIGN.md#4.4' }

        sqlitestore = component 'SQLite store' {
          #built
          technology 'node:sqlite — zero dependencies'
          summary 'Uses the database built into the runtime, so there is nothing to install.'
          description '''
            Nothing to install means nothing that can fail to install. Rows are keyed by message and carry
            a content fingerprint, which is what makes a re-run idempotent: an unchanged message is
            skipped, an edited one is triaged again.
          '''
          link ../src/store/sqlite.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#4.4'
            file 'src/store/sqlite.ts'
          }
        }

        airtableseam = component 'Airtable store' {
          #seam
          #cut
          summary 'Deliberately not built. A named migration path, not an abstraction invented for a document.'
          description '''
            The interface above is real and has a working implementation behind it. Building this is out of
            scope; the write-up explains the data model instead.
          '''
          metadata { spec 'docs/DESIGN.md#4.4' }
        }
      }

      notify = container 'Notifications' {
        summary 'A seam that is exercised rather than theoretical.'
        metadata { spec 'docs/DESIGN.md#4.5' }

        consolenotify = component 'Console notifier' {
          #built
          summary 'A real, working implementation — which is what makes the interface a seam and not a guess.'
          link ../src/integrations/notify.ts 'source'
          metadata {
            spec 'docs/DESIGN.md#4.5'
            file 'src/integrations/notify.ts'
          }
        }

        slackseam = component 'Slack notifier' {
          #seam
          #cut
          summary 'A seam, by choice. A stub that is not wired up and throws if called.'
          description '''
            Its trigger and action are documented — a high-priority verdict is written, so post to a
            channel — which doubles as the automation the write-up is asked to describe.
          '''
          metadata { spec 'docs/DESIGN.md#4.5' }
        }
      }

      db = datastore 'triage.db' {
        #built
        technology 'SQLite · WAL'
        summary 'Two tables, not three. An unreadable message is an ordinary row, not a separate bucket.'
        description '''
          It carries the label `unreadable` like any other category, which is what removed a whole surface
          from the interface.
        '''
        link ../src/store/sqlite.ts 'source'
        metadata {
          file 'src/store/sqlite.ts'
          spec 'docs/DESIGN.md#4.4'
          tables 'messages · triage_results'
          key 'triage_results keyed by message_id, carrying content_hash'
        }
      }
    }
  }

  // ── Inputs ────────────────────────────────────────────────────────────────────────────────────
  fixture = artifact 'inbound.json' {
    #built
    technology '13 messages'
    summary 'The supplied sample data, transcribed exactly — including the escapes that make it invalid.'
    description '''
      Verified rather than assumed: a strict parse fails at line 98, and the repair recovers all thirteen
      messages with the corrupted bytes still intact.
    '''
    link ../raw/inbound.json 'fixture'
    metadata { file 'raw/inbound.json' }
  }

  taxonomy = artifact 'Taxonomy and schema' {
    #built
    summary 'Categories and priorities as data rows rather than branches, plus the model output shape.'
    description '''
      Two decisions live in these files. Doubling the taxonomy adds rows and one list entry — no new
      branch, no new table.

      And the output puts the summary and supporting evidence *before* the category and priority, because
      text is generated in order and whatever comes first conditions what follows. Labels first would
      decide the answer before the reasoning that justifies it.
    '''
    link ../src/triage/types.ts 'types'
    metadata { file 'src/triage/types.ts · src/triage/schema.ts' }
  }

  // ── Relationships ─────────────────────────────────────────────────────────────────────────────
  operator -> triage.browser 'runs the triage, reads the queue'
  operator -> triage.node.preflight 'supplies the API key in .env'

  fixture -> triage.node.engine.ingest 'read at start of a run'
  taxonomy -> triage.node.engine.prompt 'generates the category list'
  taxonomy -> triage.node.engine.validate 'defines the legal values'

  triage.browser.ui -> triage.browser.apiclient 'requests rows'
  triage.browser.summarybar -> triage.browser.apiclient 'requests run outcome'
  triage.browser.apiclient -> triage.node.server 'rows only — never a credential'

  triage.node.preflight -> triage.node.server 'refuses to start without a key'
  triage.node.server -> triage.node.engine 'runs a triage, or drains the retry queue'
  triage.node.server -> triage.node.store 'reads rows to serve'

  triage.node.engine.ingest -> triage.node.engine.observations 'passes repaired messages'
  triage.node.engine.observations -> triage.node.engine.rules 'symmetric signal list'
  triage.node.engine.observations -> triage.node.engine.prompt 'observations — alongside the raw text'
  triage.node.engine.prompt -> triage.node.engine.pool 'one request per message'
  triage.node.engine.pool -> triage.node.engine.llm 'a few at a time, results in order'
  triage.node.engine.llm -> openrouter 'one call per message, strict schema'
  triage.node.engine.llm -> triage.node.engine.validate 'unchecked reply'
  triage.node.engine.validate -> triage.node.engine.reconcile 'the model verdict'
  triage.node.engine.rules -> triage.node.engine.reconcile 'the deterministic verdict'
  triage.node.engine.validate -> triage.node.engine.retry 'failed or unusable call'
  triage.node.engine.retry -> triage.node.engine.pool 'drains when the blocker clears'
  triage.node.engine.reconcile -> triage.node.store 'writes the final row'
  triage.node.engine.reconcile -> triage.node.notify 'high priority written'

  triage.node.store.sqlitestore -> triage.node.db 'reads and writes'
  triage.node.notify.consolenotify -> operator 'prints a notice'
}
