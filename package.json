{
  "name": "inbound-triage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Triages a shared-inbox queue with an LLM: summary, category, priority and next action per message.",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "tsx scripts/preflight.ts && vite",
    "build": "tsx scripts/preflight.ts && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
